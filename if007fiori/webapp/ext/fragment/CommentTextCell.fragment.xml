<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Input
        id="idCommentTextInput"
        core:require="{handler: 'zrap/if007/if007fiori/ext/fragment/CommentTextCell'}"
        value="{
            parts: [
                {path: 'SalesOrder'},
                {path: 'SalesOrderItem'},
                {path: 'CommentText'}
            ],
            formatter: 'handler.formatValue'
        }"
        liveChange="handler.onLiveChange"
        width="100%"
        editable="true"
        placeholder="输入备注" />

</core:FragmentDefinition>