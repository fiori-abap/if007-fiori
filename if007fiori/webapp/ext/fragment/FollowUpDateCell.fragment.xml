<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <DatePicker
        id="idFollowUpDatePicker"
        core:require="{handler: 'zrap/if007/if007fiori/ext/fragment/FollowUpDateCell'}"
        value="{
            parts: [
                {path: 'SalesOrder'},
                {path: 'SalesOrderItem'},
                {path: 'FollowUpDate'}
            ],
            formatter: 'handler.formatValue'
        }"
        valueFormat="yyyy-MM-dd"
        displayFormat="yyyy-MM-dd"
        change="handler.onChange"
        width="100%"
        editable="true"
        placeholder="选择日期" />

</core:FragmentDefinition>