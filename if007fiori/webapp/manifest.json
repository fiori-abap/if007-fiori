{
  "_version": "1.86.0",
  "sap.app": {
    "id": "zrap.if007.if007fiori",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "426a7ac4-2e83-4206-9ad4-bb62dd7b61f1"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_if007_o4/srvd/sap/zui_if007/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "addonService": {
        "uri": "/sap/opu/odata4/sap/zui_if007_addon_o4/srvd/sap/zui_if007_addon/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "syncService": {
        "uri": "/sap/opu/odata4/sap/zui_if007_sync_o4/srvd/sap/zui_if007_sync/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "zrap.if007.if007fiori.ext.controller.OverviewListExt"
          }
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zrap.if007.if007fiori.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "addon": {
        "dataSource": "addonService",
        "preload": false,
        "settings": {
          "operationMode": "Server",
          "updateGroupId": "if007Save"
        }
      },
      "sync": {
        "dataSource": "syncService",
        "preload": false,
        "settings": {
          "operationMode": "Server",
          "groupId": "$direct",
          "updateGroupId": "$direct"
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "OverviewList",
          "target": "OverviewList"
        }
      ],
      "targets": {
        "OverviewList": {
          "type": "Component",
          "id": "OverviewList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Overview",
              "variantManagement": "Page",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "selectionMode": "ForceMulti",
                    "beforeRebindTable": ".extension.zrap.if007.if007fiori.ext.controller.OverviewListExt.beforeRebindTable"
                  },
                  "columns": {
                    "CommentTextCell": {
                      "header": "备注",
                      "width": "15rem",
                      "position": {
                        "anchor": "DataField::CloudDeliveryDate",
                        "placement": "After"
                      },
                      "template": "zrap.if007.if007fiori.ext.fragment.CommentTextCell"
                    },
                    "FollowUpDateCell": {
                      "header": "跟进日期",
                      "width": "12rem",
                      "position": {
                        "anchor": "DataField::SapDeliveryDate",
                        "placement": "After"
                      },
                      "template": "zrap.if007.if007fiori.ext.fragment.FollowUpDateCell"
                    },
                    "SapStatusCell": {
                      "header": "SAP状态",
                      "width": "12rem",
                      "position": {
                        "anchor": "DataField::ExternalStatus",
                        "placement": "After"
                      },
                      "template": "zrap.if007.if007fiori.ext.fragment.SapStatusCell"
                    }
                  },
                  "actions": {
                    "SaveChanges": {
                      "press": "zrap.if007.if007fiori.ext.controller.SaveChanges.onSaveChanges",
                      "visible": true,
                      "enabled": "zrap.if007.if007fiori.ext.controller.SaveChanges.isEnabled",
                      "requiresSelection": true,
                      "text": "保存"
                    },
                    "SaveSap": {
                      "press": "zrap.if007.if007fiori.ext.controller.SaveChanges.onSaveSap",
                      "visible": true,
                      "enabled": "zrap.if007.if007fiori.ext.controller.SaveChanges.isSapRetryEnabled",
                      "requiresSelection": true,
                      "text": "仅保存 SAP",
                      "position": {
                        "placement": "After",
                        "anchor": "SaveChanges"
                      }
                    },
                    "SaveCloud": {
                      "press": "zrap.if007.if007fiori.ext.controller.SaveChanges.onSaveCloud",
                      "visible": true,
                      "enabled": "zrap.if007.if007fiori.ext.controller.SaveChanges.isCloudRetryEnabled",
                      "requiresSelection": true,
                      "text": "仅保存 Cloud",
                      "position": {
                        "placement": "After",
                        "anchor": "SaveSap"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}